---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for id in pageIds | reject('equalto', 'gracias') %}{% for lang in site.langs %}
  <url>
    <loc>{{ id | url(lang) }}</loc>
{%- for l in site.langs %}
    <xhtml:link rel="alternate" hreflang="{{ site.hreflang[l] }}" href="{{ id | url(l) }}"/>
{%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ id | url(site.langs[0]) }}"/>
  </url>
{%- endfor %}{% endfor %}
</urlset>
