<!doctype html>
<html lang="{{ site.hreflang[lang] }}">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{{ head.title | tr }}</title>
    <meta name="description" content="{{ head.description | tr }}" />
{% if noindex %}    <meta name="robots" content="noindex">
{% endif %}
    <!-- Canonical -->
    <link rel="canonical" href="{{ site.url }}{{ page.url | replace('/', '', 1) }}" />

    <!-- Versiones en otros idiomas -->
{%- for l in site.langs %}
    <link rel="alternate" hreflang="{{ site.hreflang[l] }}" href="{{ pageId | url(l) }}">
{%- endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ pageId | url(site.langs[0]) }}">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url | replace('/', '', 1) }}" />
    <meta property="og:title" content="{{ (head.ogTitle or head.title) | tr }}" />
    <meta property="og:description" content="{{ head.ogDescription | tr }}" />
    <meta property="og:image" content="{{ site.url }}media/{{ ogImage or 'hero-banner' }}.jpg" />
    <meta property="og:locale" content="{{ site.locales[lang] }}" />
{%- for l in site.langs %}{% if l != lang %}
    <meta property="og:locale:alternate" content="{{ site.locales[l] }}">
{%- endif %}{% endfor %}

    <!-- X (Twitter) -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content="{{ (head.ogTitle or head.title) | tr }}" />
    <meta property="twitter:description" content="{{ head.ogDescription | tr }}" />
    <meta property="twitter:image" content="{{ site.url }}media/{{ ogImage or 'hero-banner' }}.jpg" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="{{ 'media/favicon.svg' | rel }}">
{% if heroPreload %}
    <!-- Preload responsivo del hero (LCP visual) -->
    <link rel="preload" as="image" href="{{ 'media/hero-banner-mobile.webp' | rel }}" type="image/webp" media="(max-width: 768px)" fetchpriority="high"/>
    <link rel="preload" as="image" href="{{ 'media/hero-banner.webp' | rel }}" type="image/webp" media="(min-width: 769px)" fetchpriority="high"/>
{% endif %}
    <!-- Fonts: preconnects para resolver DNS/TLS en paralelo -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin/>
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>

    <!-- Switzer (fuente principal): bloqueante (LCP en hero) -->
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f%5B%5D=switzer@1&display=swap"/>

    <!-- Google Fonts (italics y labels): non-blocking via preload + onload -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Source+Serif+4:ital,wght@0,400;1,300;1,400;1,700&display=swap" onload="this.onload=null;this.rel='stylesheet'"/>
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Source+Serif+4:ital,wght@0,400;1,300;1,400;1,700&display=swap"/></noscript>
{% if icons %}
    <!-- Icons - RemixIcon (non-blocking) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin/>
    <link rel="preload" as="style" href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" onload="this.onload=null;this.rel='stylesheet'"/>
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css"/></noscript>
{% endif %}
    <!-- Styles & Scripts -->
    <link rel="stylesheet" href="{{ 'css/index.css' | rel }}" />
    <script defer src="{{ 'js/index.js' | rel }}"></script>
</head>

<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

{% include "header.njk" %}

{% include "navigation.njk" %}

{% block main %}{% endblock %}
</body>
</html>
