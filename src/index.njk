---
pagination:
  data: langPages
  size: 1
  alias: pg
permalink: "{{ 'index' | route(pg.lang) }}"
heroPreload: true
---
{% extends "base.njk" %}
{% set pageId = "index" %}
{% from "macros.njk" import next, langSwitch, picture with context %}
{% set head = t.pages.index %}

{% block main %}
<!-- =======================================================================================
    MAIN
======================================================================================= -->
<main>

    <!-- Imagen fija que transiciona de hero a about -->
    <div class="scroll-image" id="scrollImage">
        <picture>
            <source
                srcset="{{ 'media/hero-banner-mobile.webp' | rel }}"
                type="image/webp"
                media="(max-width: 768px)"
            />
            <source
                srcset="{{ 'media/hero-banner-mobile.jpg' | rel }}"
                media="(max-width: 768px)"
            />
            <source
                srcset="{{ 'media/hero-banner.webp' | rel }}"
                type="image/webp"
            />
            <img
                src="{{ 'media/hero-banner.jpg' | rel }}"
                alt="{{ t.home.heroAlt }}"
                loading="eager"
                fetchpriority="high"
            />
        </picture>
    </div>

    <!-- Hero ======================================================================================= -->
    <section class="hero" id="hero">
        {{ langSwitch("lang-hero", "hero__lang", "nav-link--light") }}

        <div class="hero__top">
            <h1 class="hero__title heading-display">Gustavo Tondin</h1>
            <p class="hero__location label">{{ t.home.location }}</p>
        </div>

        <div class="hero__info">
            <a href="{{ 'portfolio' | href }}" class="nav-link nav-link--light nav-link--bordered">
                {{ t.nav.portfolio }}
                <span class="nav-link__circle"></span>
            </a>
            <p class="hero__tagline">
                {{ t.home.tagline | safe }}
            </p>
        </div>

        <nav class="hero__side-nav">
            <a href="#about" class="nav-link nav-link--light">{{ t.home.about }}</a>
            <a href="{{ 'contacto' | href }}" class="nav-link nav-link--light">{{ t.nav.contact }}</a>
        </nav>
    </section>

    <!-- Sobre Mí ======================================================================================= -->
    <section class="section" id="about">
        <div class="about">
            <div class="about__image" id="aboutImageTarget"></div>

            <div class="about__content">
                <!-- Sub-container: label + título pegados -->
                <div class="about__lead">
                    <span class="label">{{ t.home.hello }}</span>
                    <h2 class="about__title">Gustavo Tondin</h2>
                </div>

                <!-- Sub-container: los 3 párrafos apilados -->
                <div class="about__paragraphs">
{%- for text in t.home.paragraphs %}
                    <p class="about__text">{{ text }}</p>
{%- endfor %}
                </div>
            </div>
        </div>
    </section>

    <!-- Áreas de trabajo ======================================================================================= -->
    <!-- data-spotlight activa sirve para mostrar las imagenes correctas en el hover. -->
    <section class="marquee" aria-label="{{ t.home.marqueeLabel }}">
        <div class="marquee__track">
{%- for c in categories %}

            <a href="{{ c.id | href }}" class="marquee__item marquee__item--{{ c.id }} label" data-category="{{ c.id }}" data-previews="{% for k in c.previews %}{{ ('media/' + k + '.jpg') | rel }}{% if not loop.last %} {% endif %}{% endfor %}">
                <img class="marquee__preview" src="#" alt="{{ t.home.marquee[c.id].alt }}">
                <span class="marquee__text">{{ t.home.marquee[c.id].text }}</span>
            </a>
{%- endfor %}

        </div>
    </section>

    <!-- Cómo trabajo ======================================================================================= -->
    <section class="section" aria-labelledby="stepsTitle">
        <h2 class="section__title" id="stepsTitle">{{ t.home.stepsTitle }}</h2>
        <ol class="steps">
{%- for step in t.home.steps %}
            <li class="steps__item">
                <span class="steps__number label">0{{ loop.index }}</span>
                <h3 class="h4 steps__title">{{ step.title }}</h3>
                <p class="steps__text">{{ step.text }}</p>
            </li>
{%- endfor %}
        </ol>
    </section>

    <!-- Testimonios ======================================================================================= -->
    <!-- testimonios en formato stories: la foto del proyecto es el fondo, la barra del cliente activo marca el tiempo y el toque en los lados cambia (js/index.js) -->
    <section class="testimonials" aria-labelledby="testimonialsTitle">
        <div class="stories" data-stories>
            <div class="stories__media" aria-hidden="true">
{%- for item in t.home.testimonials %}
                <div class="stories__bg{% if loop.first %} is-active{% endif %}" data-story="{{ loop.index0 }}">
                    {{ picture(item.image, "100vw") }}
                </div>
{%- endfor %}
            </div>
            <div class="stories__zones" aria-hidden="true">
                <span class="stories__zone stories__zone--prev"></span>
                <span class="stories__zone stories__zone--next"></span>
            </div>
            <div class="stories__head">
                <h2 class="stories__title" id="testimonialsTitle">{{ t.home.testimonialsTitle }}</h2>
                <div class="stories__tabs" role="tablist" aria-label="{{ t.home.testimonialsTitle }}">
{%- for item in t.home.testimonials %}
                    <button class="stories__tab" type="button" role="tab" id="testimonialTab{{ loop.index }}" aria-controls="testimonial{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}">
                        <span class="stories__progress"></span>
                        <span class="stories__client label">{{ projects[item.project].name }}</span>
                    </button>
{%- endfor %}
                </div>
            </div>
            <div class="stories__stage">
{%- for item in t.home.testimonials %}
{%- set p = projects[item.project] %}
                <div class="story{% if loop.first %} is-active{% endif %}" id="testimonial{{ loop.index }}" role="tabpanel" aria-labelledby="testimonialTab{{ loop.index }}" data-story="{{ loop.index0 }}" data-category="{{ p.category }}">
                    <figure class="story__figure">
                        <blockquote class="story__quote">
                            <p>“{{ item.quote }}”</p>
                        </blockquote>
                        <figcaption class="story__author">
                            <span class="story__name">{{ item.name }}</span>
                            <span class="story__role">{{ item.role }} · {{ item.place }}</span>
{%- if item.credit %}
                            <span class="story__credit label">{{ item.credit }}</span>
{%- endif %}
                        </figcaption>
                    </figure>
                    <a href="{{ ('projects/' + item.project) | href }}" class="btn story__link" style="--btn-color: var(--color-light); --btn-hover-txt: var(--color-dark)" aria-label="{{ t.home.testimonialLink }}: {{ p.name }}">
                        {{ t.home.testimonialLink }} <span class="icon-chevron" aria-hidden="true"></span>
                    </a>
                </div>
{%- endfor %}
            </div>
        </div>
    </section>

    <!-- CV Grid ======================================================================================= -->
    <section class="section">
        <div class="cv">

            <div class="card cv__card cv__card--focus">
                <h2 class="cv__heading label">{{ t.home.focus }}</h2>
                <h3 class="heading-display">{{ t.home.focusTitle }}</h3>
                <p class="cv__text">{{ t.home.focusText }}</p>
            </div>

            <div class="card cv__card cv__card--contact">
                <h3 class="cv__heading label">{{ t.home.contact }}</h3>
                <p class="cv__text">{{ t.home.city }}</p>
                <div class="cv__links">
                    <a href="mailto:gus.tondin@gmail.com" class="cv__link link">gus.tondin@gmail.com</a>
                    <a href="https://www.behance.net/gustavotondin" class="cv__link link">Behance</a>
                    <a href="https://github.com/Gustavo-Tondin" class="cv__link link">GitHub</a>
                    <a href="https://www.linkedin.com/in/gustavo-tondin" class="cv__link link">LinkedIn</a>
                </div>
            </div>

            <div class="card cv__card cv__card--exp">
                <h3 class="cv__heading label">{{ t.home.experience }}</h3>
{% for job in t.home.jobs %}
                <div class="cv__content">
                    <span class="cv__date label">{{ job.date }}</span>
                    <h4 class="cv__role">{{ job.role }}</h4>
                    <p class="cv__detail">{{ job.place }}</p>
                    <p class="cv__text">{{ job.text }}</p>
                </div>
{% endfor %}
            </div>

            <div class="card cv__card cv__card--do">
                <h3 class="cv__heading label">{{ t.home.doTitle }}</h3>
                <ul class="cv__list">
{%- for item in t.home.do %}
                    <li>{{ item }}</li>
{%- endfor %}
                </ul>
            </div>

            <div class="card cv__card cv__card--skills">
                <h3 class="cv__heading label">{{ t.home.skillsTitle }}</h3>
                <h4 class="cv__subheading">{{ t.home.tools }}</h4>
                <div class="cv__tags">
{%- for tool in ["Illustrator", "Photoshop", "InDesign", "Lightroom", "Figma", "HTML / CSS / JS", "SASS", "WordPress", "Git", "Fontra"] %}
                    <span class="tag-pill">{{ tool }}</span>
{%- endfor %}
                </div>
                <h4 class="cv__subheading">{{ t.home.languagesLabel }}</h4>
                <div class="cv__tags">
{%- for language in t.home.languages %}
                    <span class="tag-pill">{{ language }}</span>
{%- endfor %}
                </div>
            </div>

        </div>
    </section>

    <!-- CTA ======================================================================================= -->
    <section class="section cta" aria-labelledby="ctaTitle">
        <h2 class="cta__title" id="ctaTitle">{{ t.home.ctaText }}</h2>
        <a href="{{ 'contacto' | href }}" class="btn">
            {{ t.home.ctaButton }} <span class="icon-chevron" aria-hidden="true"></span>
        </a>
    </section>

    <!-- Próxima Sesión ======================================================================================= -->
    {{ next("portfolio", "portfolio", t.nav.portfolio, t.next.nextSection, "", t.next.section) }}
</main>
{% endblock %}
