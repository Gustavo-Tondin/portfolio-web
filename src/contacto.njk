---
pagination:
  data: langPages
  size: 1
  alias: pg
permalink: "{{ 'contacto' | route(pg.lang) }}"
bodyClass: page-contacto
navCurrent: contacto
---
{% extends "base.njk" %}
{% set pageId = "contacto" %}
{% set head = t.pages.contacto %}

{% block main %}
<!-- =======================================================================================
    MAIN
======================================================================================= -->
<main>

    <!-- Contacto ======================================================================================= -->
    <section class="contact" aria-labelledby="contactoTitulo">

        <h1 class="contact__title heading-display">{{ t.contact.title }}</h1>

        <form class="contact__form" action="https://api.web3forms.com/submit" method="post">

            <!-- Web3Forms -->
            <input type="hidden" name="access_key" value="{{ site.web3formsKey }}">
            <input type="hidden" name="subject" value="{{ t.contact.subject }}">
            <input type="hidden" name="from_name" value="Portfolio Gustavo Tondin">
            <input type="hidden" name="redirect" value="{{ 'gracias' | url(lang) }}">
            <input type="checkbox" name="botcheck" tabindex="-1" hidden>

            <div class="contact__row">

                <!-- Nombre -->
                <div class="contact__field">
                    <label class="contact__label label" for="contactNombre">{{ t.contact.name }}</label>
                    <input
                        class="contact__input"
                        type="text"
                        id="contactNombre"
                        name="name"
                        autocomplete="name"
                        required
                    >
                </div>

                <!-- Correo electrónico -->
                <div class="contact__field">
                    <label class="contact__label label" for="contactEmail">{{ t.contact.email }}</label>
                    <input
                        class="contact__input"
                        type="email"
                        id="contactEmail"
                        name="email"
                        autocomplete="email"
                        required
                    >
                </div>

            </div>

            <!-- Mensaje -->
            <div class="contact__field">
                <label class="contact__label label" for="contactMensaje">{{ t.contact.message }}</label>
                <textarea
                    class="contact__textarea"
                    id="contactMensaje"
                    name="message"
                    rows="4"
                    required
                ></textarea>
            </div>

            <div class="contact__captcha h-captcha" data-captcha="true" data-lang="{{ site.hreflang[lang] }}"></div>

            <p class="contact__note">{{ t.contact.privacy }}</p>

            <button
                class="contact__submit btn"
                type="submit"
                style="--btn-padding: 1.125rem clamp(3rem, 10vw, 6rem);"
            >{{ t.contact.send }}</button>
        </form>

    </section>

</main>
{% endblock %}
